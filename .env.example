# Copy to .env and adjust. Never commit the real .env file.
# All 13 application variables below are required (PROJECT_ARCHITECTURE.md §15).

NODE_ENV=development
PORT=3000

# Runtime connection (app_user role) and migration connection (owner role) — T0.3 creates the roles.
# Postgres runs on host port 5434 and Redis on 6381 (docker-compose.yml); 5432/5433/6379 are taken by other projects.
DATABASE_URL=postgresql://businesslens:businesslens@localhost:5434/businesslens
DATABASE_MIGRATION_URL=postgresql://businesslens_owner:businesslens@localhost:5434/businesslens

REDIS_URL=redis://localhost:6381

# Generate a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

# Frontend origin(s), comma-separated, scheme + host only (no path)
CORS_ORIGIN=http://localhost:5173

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

UPLOAD_DIR=./uploads

# Placeholders are accepted while AI_ENABLED=false; real values are needed only for AI explanations.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model
AI_ENABLED=true

# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=businesslens
POSTGRES_PASSWORD=businesslens
POSTGRES_DB=businesslens
