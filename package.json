{
  "name": "businesslens-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BusinessLens backend — CSV import, deterministic metrics, rule-based findings, AI explanations",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "start:worker": "npm run build && node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
