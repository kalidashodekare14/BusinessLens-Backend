{
  "name": "businesslens-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BusinessLens backend — CSV import, deterministic metrics, rule-based findings, AI explanations",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "pretest": "prisma generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "pretest:e2e": "prisma generate",
    "test:e2e": "node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js",
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:api": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "start:worker": "npm run build && node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
